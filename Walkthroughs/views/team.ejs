<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Manage Team</title>

  <%- include('partials/header') %>
</head>

<body>

  <div class="container py-5 text-center">

    <h1 class="mb-3">Manage Team</h1>

    <p class="mb-4">
      <a href="/" class="btn btn-outline-primary">
        Back to Scheduler
      </a>
    </p>

    <% if (error) { %>
      <div class="alert alert-danger w-auto mx-auto" role="alert">
        <%= error %>
      </div>
    <% } %>

    <div class="card w-auto mx-auto mb-5 shadow-sm">
      <div class="card-body">
        <h2 class="card-title mb-3">Add Team Member</h2>

        <form method="POST" action="/team/add" class="d-flex justify-content-center gap-2 flex-wrap">
          <input
            type="text"
            name="name"
            class="form-control w-auto"
            placeholder="Enter name"
            required
          >

          <button type="submit" class="btn btn-success">
            Add Member
          </button>
        </form>
      </div>
    </div>

    <h2 class="mb-3">Current Team Members</h2>

    <div class="table-responsive d-flex justify-content-center">
      <table class="table table-bordered table-striped table-hover w-auto align-middle">
        <thead class="table-dark">
          <tr>
            <th>Name</th>
            <th>Prom/NQ Count</th>
            <th>Main Count</th>
            <th>Available</th>
            <th>Remove</th>
          </tr>
        </thead>

        <tbody>
          <% people.forEach(person => { %>
            <tr>
              <td>
                <%= person.name %>
              </td>

              <td>
                <%= person.promCount %>
              </td>

              <td>
                <%= person.mainCount %>
              </td>

              <td>
                <% if (person.available) { %>
                  <span class="badge text-bg-success">Available</span>
                <% } else { %>
                  <span class="badge text-bg-danger">Unavailable</span>
                <% } %>
              </td>

              <td>
                <form method="POST" action="/team/delete" class="m-0">
                  <input type="hidden" name="id" value="<%= person.id %>">

                  <button
                    type="submit"
                    class="btn btn-sm btn-outline-danger"
                    onclick="return confirm('Remove <%= person.name %> from the team?')"
                  >
                    Remove
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>

  <%- include('partials/footer') %>

</body>

</html>