<!DOCTYPE html>
<html>

<head>
    <title>Edit Team Member</title>
    <%- include('partials/header.ejs') %>
</head>

<body class="bg-light">

    <div class="container mt-5">

        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <h3 class="card-title mb-4 text-center">Edit Team Member</h3>

                        <div class="mb-3 text-center">
                            <a href="/team" class="btn btn-outline-secondary btn-sm">
                                ← Back to Team
                            </a>
                        </div>

                        <% if (error) { %>
                            <div class="alert alert-danger text-center">
                                <%= error %>
                            </div>
                            <% } %>

                                <form method="POST" action="/team/edit/<%= person.id %>">

                                    <!-- Name -->
                                    <div class="mb-3">
                                        <label class="form-label">Name</label>
                                        <input type="text" name="name" class="form-control" value="<%= person.name %>"
                                            required>
                                    </div>

                                    <!-- Area counts -->
                                    <% areas.forEach(area => { %>
                                        <div class="mb-3">
                                            <label class="form-label"><%= area.name %> Count</label>
                                            <input type="number" name="count_<%= area.id %>" class="form-control"
                                                value="<%= person.counts?.[area.id] ?? 0 %>" min="0" required>
                                        </div>
                                    <% }) %>

                                    <!-- Availability -->
                                    <div class="form-check mb-4">
                                        <input class="form-check-input" type="checkbox" name="available"
                                            id="availableCheck" <%=person.available ? "checked" : "" %>
                                        >
                                        <label class="form-check-label" for="availableCheck">
                                            Available
                                        </label>
                                    </div>

                                    <!-- Submit -->
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary">
                                            Save Changes
                                        </button>
                                    </div>

                                </form>

                    </div>
                </div>

            </div>
        </div>

    </div>

    <%- include('partials/footer.ejs') %>
</body>

</html>
