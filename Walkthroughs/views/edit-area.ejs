<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Area</title>

  <%- include('partials/header.ejs') %>
</head>

<body>

  <div class="container py-5">

    <div class="card mx-auto shadow-sm" style="max-width: 600px;">
      <div class="card-body">

        <h1 class="h3 mb-4">
          Edit Area
        </h1>

        <% if (error) { %>
          <div class="alert alert-danger">
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/areas/edit/<%= area.id %>">

          <div class="mb-3">
            <label for="name" class="form-label">
              Area Name
            </label>

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              value="<%= area.name %>"
              required
            >
          </div>

          <div class="mb-3">
            <label for="peopleNeeded" class="form-label">
              People Needed
            </label>

            <input
              type="number"
              id="peopleNeeded"
              name="peopleNeeded"
              class="form-control"
              value="<%= area.peopleNeeded %>"
              min="1"
              step="1"
              required
            >
          </div>

          <div class="form-check mb-4">
            <input
              type="checkbox"
              id="active"
              name="active"
              class="form-check-input"
              <%= area.active ? "checked" : "" %>
            >

            <label for="active" class="form-check-label">
              Include this area when generating assignments
            </label>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              Save Changes
            </button>

            <a href="/areas" class="btn btn-outline-secondary">
              Cancel
            </a>
          </div>

        </form>

      </div>
    </div>

  </div>

  <%- include('partials/footer') %>

</body>

</html>