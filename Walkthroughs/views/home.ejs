<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Walkthrough Scheduler</title>

  <%- include('partials/header.ejs') %>
</head>

<body>

  <div class="container py-5 text-center">

    <h1 class="mb-3">Walkthrough Scheduler</h1>

    <p class="mb-4 d-flex justify-content-center gap-2 flex-wrap">
      <a href="/team" class="btn btn-outline-primary">
        Manage Team Members
      </a>

      <a href="/areas" class="btn btn-outline-secondary">
        Manage Areas
      </a>

      <a href="/find-single" class="btn btn-outline-success">
        Find Single Replacement
      </a>
    </p>

    <% if (error) { %>
      <div class="alert alert-danger w-auto mx-auto" role="alert">
        <%= error %>
      </div>
    <% } %>

    <% if (assignment && Array.isArray(assignment.groups)) { %>
      <div class="card w-auto mx-auto mb-4 shadow-sm">
        <div class="card-body">

          <h2 class="card-title mb-3">
            This Week's Assignment
          </h2>

          <p class="card-text">
            <strong>Date:</strong>
            <%= assignment.date %>
          </p>

          <% assignment.groups.forEach(group => { %>
            <p class="card-text">
              <strong><%= group.areaName %>:</strong>

              <% if (group.people && group.people.length > 0) { %>
                <%= group.people
                  .map(person => person.name)
                  .join(" & ") %>
              <% } else { %>
                Nobody assigned
              <% } %>
            </p>
          <% }) %>

        </div>
      </div>
    <% } %>

    <h2 class="mb-3">Team Members</h2>

    <div class="table-responsive">
      <table class="table table-bordered table-striped table-hover align-middle">

        <thead class="table-dark">
          <tr>
            <th>Name</th>

            <% areas.forEach(area => { %>
              <th>
                <%= area.name %> Count

                <% if (!area.active) { %>
                  <span class="badge text-bg-secondary ms-1">
                    Inactive
                  </span>
                <% } %>
              </th>
            <% }) %>

            <th>Available</th>
            <th>Availability</th>
            <th>Edit</th>
          </tr>
        </thead>

        <tbody>

          <% people.forEach(person => { %>
            <tr>

              <td>
                <%= person.name %>
              </td>

              <% areas.forEach(area => { %>
                <td>
                  <%= person.counts?.[area.id] ?? 0 %>
                </td>
              <% }) %>

              <td>
                <% if (person.available) { %>
                  <span class="badge text-bg-success">
                    Available
                  </span>
                <% } else { %>
                  <span class="badge text-bg-danger">
                    Unavailable
                  </span>
                <% } %>
              </td>

              <td>
                <form method="POST" action="/toggle" class="m-0">
                  <input
                    type="hidden"
                    name="id"
                    value="<%= person.id %>"
                  >

                  <button
                    type="submit"
                    class="btn btn-sm <%= person.available
                      ? 'btn-outline-danger'
                      : 'btn-outline-success' %>"
                  >
                    <%= person.available
                      ? "Set Unavailable"
                      : "Set Available" %>
                  </button>
                </form>
              </td>

              <td>
                <a
                  href="/team/edit/<%= person.id %>"
                  class="btn btn-sm btn-outline-primary"
                >
                  Edit
                </a>
              </td>

            </tr>
          <% }) %>

          <% if (people.length === 0) { %>
            <tr>
              <td
                colspan="<%= areas.length + 4 %>"
                class="text-center text-muted"
              >
                No team members have been added.
              </td>
            </tr>
          <% } %>

        </tbody>

      </table>
    </div>

    <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">

      <form method="POST" action="/generate">
        <button type="submit" class="btn btn-primary">
          Generate Walkers
        </button>
      </form>

      <a href="/find-single" class="btn btn-outline-success">
        Find Single Replacement
      </a>

      <form method="POST" action="/reset">
        <button
          type="submit"
          class="btn btn-outline-danger"
          onclick="return confirm('Are you sure you want to reset all counts and history?')"
        >
          Reset Counters
        </button>
      </form>

    </div>

  </div>

  <%- include('partials/footer') %>

</body>

</html>