<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Find Single Replacement</title>

  <%- include('partials/header.ejs') %>
</head>

<body>

  <div class="container py-5 text-center">

    <h1 class="mb-3">Find Single Replacement</h1>

    <p class="mb-4">
      <a href="/" class="btn btn-outline-secondary">
        Back to Scheduler
      </a>

      <a href="/team" class="btn btn-outline-primary">
        Manage Team Members
      </a>
    </p>

    <% if (error) { %>
      <div class="alert alert-danger w-auto mx-auto" role="alert">
        <%= error %>
      </div>
    <% } %>

    <% if (replacement) { %>
      <div class="card w-auto mx-auto mb-4 shadow-sm">
        <div class="card-body">
          <h2 class="card-title mb-3">Replacement Found</h2>

          <p class="card-text">
            <strong>Name:</strong>
            <%= replacement.name %>
          </p>

          <p class="card-text">
            <strong>Area:</strong>
            <%= area === "prom" ? "Prom/NQ" : "Main" %>
          </p>

          <div class="alert alert-success mb-0" role="alert">
            <%= replacement.name %>'s
            <%= area === "prom" ? "Prom/NQ" : "Main" %>
            count has been increased by 1.
          </div>
        </div>
      </div>
    <% } %>

    <div class="card w-auto mx-auto mb-4 shadow-sm">
      <div class="card-body">
        <h2 class="card-title mb-3">Choose Area</h2>

        <form method="POST" action="/find-single">
          <div class="mb-3">
            <label for="area" class="form-label">
              Which area needs a replacement?
            </label>

            <select name="area" id="area" class="form-select w-auto mx-auto" required>
              <option value="">Choose one</option>
              <option value="prom">Prom/NQ</option>
              <option value="main">Main</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary">
            Find Replacement
          </button>
        </form>
      </div>
    </div>

    <h2 class="mb-3">Team Members</h2>

    <div class="table-responsive d-flex justify-content-center">
      <table class="table table-bordered table-striped table-hover w-auto align-middle">
        <thead class="table-dark">
          <tr>
            <th>Name</th>
            <th>Prom/NQ Count</th>
            <th>Main Count</th>
            <th>Available</th>
            <th>Edit</th>
          </tr>
        </thead>

        <tbody>
          <% people.forEach(person => { %>
            <tr>
              <td>
                <%= person.name %>
              </td>

              <td>
                <%= person.promCount %>
              </td>

              <td>
                <%= person.mainCount %>
              </td>

              <td>
                <% if (person.available) { %>
                  <span class="badge text-bg-success">Available</span>
                <% } else { %>
                  <span class="badge text-bg-danger">Unavailable</span>
                <% } %>
              </td>

              <td>
                <a href="/team/edit/<%= person.id %>" class="btn btn-sm btn-outline-primary">
                  Edit
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>

  <%- include('partials/footer') %>

</body>

</html>